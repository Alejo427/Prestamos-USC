@model ResumenDashboard
@{ ViewData["Title"] = "Inicio"; }

<section class="hero p-4 p-md-5 mb-4">
    <h1 class="display-6 fw-bold">Préstamo de equipos y salas</h1>
    <p class="lead mb-3">Consulta el catálogo, reserva un equipo o una sala y lleva el control de tus devoluciones.</p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-controller="Recursos" asp-action="Index" class="btn btn-warning me-2 mb-2">Ver catálogo</a>
        <a asp-controller="Prestamos" asp-action="MisPrestamos" class="btn btn-outline-light mb-2">Mis préstamos</a>
    }
    else
    {
        <a asp-controller="Account" asp-action="Login" class="btn btn-warning me-2 mb-2">Iniciar sesión</a>
        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light mb-2">Crear cuenta</a>
    }
</section>

<div class="row row-cols-2 row-cols-lg-4 g-3 mb-4">
    <div class="col"><div class="card stat-card shadow-sm h-100"><div class="card-body">
        <div class="text-muted small">Recursos registrados</div><div class="display-6">@Model.TotalRecursos</div></div></div></div>
    <div class="col"><div class="card stat-card shadow-sm h-100"><div class="card-body">
        <div class="text-muted small">Préstamos activos</div><div class="display-6">@Model.PrestamosActivos</div></div></div></div>
    <div class="col"><div class="card stat-card shadow-sm h-100"><div class="card-body">
        <div class="text-muted small">Préstamos vencidos</div><div class="display-6">@Model.PrestamosVencidos</div></div></div></div>
    <div class="col"><div class="card stat-card shadow-sm h-100"><div class="card-body">
        <div class="text-muted small">No disponibles</div><div class="display-6">@Model.RecursosNoDisponibles</div></div></div></div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white fw-semibold">Préstamos por estado</div>
    <ul class="list-group list-group-flush">
        @foreach (var estado in Enum.GetValues<EstadoPrestamo>())
        {
            var cantidad = Model.PrestamosPorEstado.TryGetValue(estado, out var n) ? n : 0;
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span class="badge @estado.ClaseBadge()">@estado.Texto()</span>
                <span class="fw-semibold">@cantidad</span>
            </li>
        }
    </ul>
</div>
