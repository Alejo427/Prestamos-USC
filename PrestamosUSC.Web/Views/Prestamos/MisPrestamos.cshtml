@model IEnumerable<Prestamo>
@{ ViewData["Title"] = "Mis préstamos"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Mis préstamos</h1>
    <a asp-controller="Recursos" asp-action="Index" class="btn btn-usc btn-sm">Nuevo préstamo</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Aún no tienes préstamos. Ve al catálogo para solicitar uno.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Recurso</th><th>Inicio</th><th>Fin</th><th>Estado</th><th class="text-end">Acciones</th></tr>
                </thead>
                <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.Recurso.Nombre <div class="text-muted small">@p.Recurso.Codigo</div></td>
                        <td class="text-nowrap">@p.FechaInicio.ToTextoCorto()</td>
                        <td class="text-nowrap">@p.FechaFin.ToTextoCorto()</td>
                        <td>
                            <span class="badge @p.Estado.ClaseBadge()">@p.Estado.Texto()</span>
                            @if (p.EstaVencido) { <span class="badge bg-danger">Vencido</span> }
                        </td>
                        <td class="text-end text-nowrap">
                            @if (p.Estado == EstadoPrestamo.Activo)
                            {
                                if (p.FechaInicio > DateTime.Now)
                                {
                                    <form asp-action="Cancelar" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <button class="btn btn-outline-secondary btn-sm">Cancelar</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Devolver" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <button class="btn btn-success btn-sm">Devolver</button>
                                    </form>
                                }
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
