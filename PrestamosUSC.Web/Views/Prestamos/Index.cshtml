@model IEnumerable<Prestamo>
@{
    ViewData["Title"] = "Todos los préstamos";
    var estadoSel = ViewBag.Estado as EstadoPrestamo?;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Todos los préstamos</h1>
    <form method="get" class="d-flex gap-2">
        <select name="estado" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">Todos los estados</option>
            @foreach (var e in Enum.GetValues<EstadoPrestamo>())
            {
                <option value="@e" selected="@(estadoSel == e)">@e.Texto()</option>
            }
        </select>
    </form>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>#</th><th>Usuario</th><th>Recurso</th><th>Inicio</th><th>Fin</th><th>Estado</th><th class="text-end">Acciones</th></tr>
            </thead>
            <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Id</td>
                    <td>@p.Usuario.NombreCompleto <div class="text-muted small">@p.Usuario.Email</div></td>
                    <td>@p.Recurso.Nombre <div class="text-muted small">@p.Recurso.Codigo</div></td>
                    <td class="text-nowrap">@p.FechaInicio.ToTextoCorto()</td>
                    <td class="text-nowrap">@p.FechaFin.ToTextoCorto()</td>
                    <td>
                        <span class="badge @p.Estado.ClaseBadge()">@p.Estado.Texto()</span>
                        @if (p.EstaVencido) { <span class="badge bg-danger">Vencido</span> }
                    </td>
                    <td class="text-end text-nowrap">
                        @if (p.Estado == EstadoPrestamo.Activo)
                        {
                            <form asp-action="Devolver" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@p.Id" />
                                <input type="hidden" name="volverA" value="admin" />
                                <button class="btn btn-success btn-sm">Devolver</button>
                            </form>
                            if (p.FechaInicio > DateTime.Now)
                            {
                                <form asp-action="Cancelar" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <input type="hidden" name="volverA" value="admin" />
                                    <button class="btn btn-outline-secondary btn-sm">Cancelar</button>
                                </form>
                            }
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
